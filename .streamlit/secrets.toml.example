# Copy this to secrets.toml locally, or paste into Streamlit Cloud secrets
TENANT_ID = "your-tenant-id"
CLIENT_ID = "your-client-id"
CLIENT_SECRET = "your-client-secret"
SHAREPOINT_FILE_URL = "your-pipeline-url"
BUDGET_FILE_URL = "your-budget-url"
SCOPE_FILE_URL = "your-scope-url"
GITHUB_TOKEN = "your-github-personal-access-token"

# 2027 Budget tab — password + email 2FA gate
BUDGET_2027_PASSWORD = "choose-a-shared-password"
BUDGET_2027_ALLOWED_EMAILS = [
    "nikesh@imagineneverland.com",
    "josh@imagineneverland.com",
    "neil@imagineneverland.com",
    "amy@imagineneverland.com",
]

# Mailbox the 2FA codes are sent from, via Microsoft Graph (not SMTP —
# most Microsoft 365 tenants block legacy SMTP AUTH outright).
# Requires the Mail.Send application permission (admin-consented) on the
# Azure AD app registration used for TENANT_ID/CLIENT_ID/CLIENT_SECRET above.
SMTP_FROM = "nikesh@imagineneverland.com"
